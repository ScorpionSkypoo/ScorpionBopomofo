    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#FF4FC8F4" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/ime_key_action_bg" /></shape>
    </item>
</selector>
