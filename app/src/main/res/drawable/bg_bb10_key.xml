<?xml version="1.0" encoding="utf-8"?>
<!-- BlackBerry 10 風格按鍵：扁平直角、純色，按下變藍 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF00A8DF" />
            <stroke android:width="?attr/imeKeyStroke" android:color="?attr/imeKeyStrokeColor" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ime_key_bg" />
            <stroke android:width="?attr/imeKeyStroke" android:color="?attr/imeKeyStrokeColor" />
        </shape>
    </item>
</selector>
