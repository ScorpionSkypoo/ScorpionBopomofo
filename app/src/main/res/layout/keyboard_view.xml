<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_keyboard_root">

    <!-- 1. 頂部工具列 / 候選字列 (高度 46dp，背景無縫融入鍵盤底色，無分隔線) -->
    <FrameLayout
        android:id="@+id/candidate_bar_container"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@android:color/transparent">

        <!-- 狀態 A: 閒置工具列 (無候選字時顯示統一設計的簡約向量圖標) -->
        <LinearLayout
            android:id="@+id/layout_idle_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- 工具（Emoji、顏文字、手寫與安裝的擴充功能）：顯示哪些、順序在設定裡調，程式動態加入；
                 開著最近使用列時只放前兩個＋「更多」，其他時候整條都是工具、可以左右滑（寬度由程式依狀態調整） -->
            <HorizontalScrollView
                android:id="@+id/scroll_tools"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never">
                <LinearLayout
                    android:id="@+id/layout_tools"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <!-- 工具與右邊的最近使用列（或自動填入建議）之間的分隔線：兩邊都有東西才顯示 -->
            <View
                android:id="@+id/tool_divider"
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp"
                android:alpha="0.35"
                android:background="@color/ime_text_secondary"
                android:visibility="gone" />

            <!-- 自動填入服務給的建議（簡訊驗證碼、密碼、地址）：有建議時整條只放建議、置中，點了由系統填進輸入框 -->
            <HorizontalScrollView
                android:id="@+id/scroll_inline_suggestions"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/layout_inline_suggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />
            </HorizontalScrollView>

            <!-- 常駐最近使用的 Emoji／顏文字（設定開啟才有內容），可以左右滑；沒開時當空白撐開 -->
            <HorizontalScrollView
                android:id="@+id/scroll_recent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never">
                <LinearLayout
                    android:id="@+id/layout_recent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />
            </HorizontalScrollView>

        </LinearLayout>

        <!-- 狀態 B: 活躍候選字列 (打字時顯示) -->
        <LinearLayout
            android:id="@+id/layout_candidate_active"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_candidates"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:overScrollMode="never" />

            <FrameLayout
                android:id="@+id/btn_expand_candidates"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/imeItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/iv_expand_chevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ime_chevron_down"
                    android:tint="@color/ime_text_primary" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 2. 展開面板 (包含全螢幕候選字大列表、Emoji 庫與豐富顏文字分類) -->
    <LinearLayout
        android:id="@+id/panel_expanded"
        android:layout_width="match_parent"
        android:layout_height="246dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/ime_bg">

        <!-- 頂部分類頁籤列 (Gboard 風格極簡膠囊分類) -->
        <!-- 頁籤列＋刪除鍵（Emoji、顏文字、擴充功能面板裡也能直接刪字） -->
        <LinearLayout
            android:id="@+id/layout_expanded_header"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never">
                <LinearLayout
                    android:id="@+id/layout_expanded_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>
            <FrameLayout
                android:id="@+id/btn_panel_backspace"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="?attr/imeItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="刪除">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ime_backspace"
                    android:tint="@color/ime_text_primary" />
            </FrameLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_expanded_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- 3. 注音大千主鍵盤 (按鍵高度 44dp，維持 2.5dp 原始黃金間距，全域由空間座標定位模式接管) -->
    <LinearLayout
        android:id="@+id/panel_zhuyin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <!-- 常駐數字列（設定開啟才顯示） -->
        <LinearLayout
            android:id="@+id/row_numbers"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:weightSum="10"
            android:visibility="gone" />

        <com.p3dro.scorpio.ime.ui.ZhuyinGridLayout
            android:id="@+id/grid_zhuyin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 第 1 排 (44dp) -->
            <LinearLayout
                android:id="@+id/row_1"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:weightSum="10" />

            <!-- 第 2 排 (44dp) -->
            <LinearLayout
                android:id="@+id/row_2"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:weightSum="10" />

            <!-- 第 3 排 (44dp) -->
            <LinearLayout
                android:id="@+id/row_3"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:weightSum="10" />

            <!-- 第 4 排 (44dp) -->
            <LinearLayout
                android:id="@+id/row_4"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:weightSum="10" />
        </com.p3dro.scorpio.ime.ui.ZhuyinGridLayout>

        <!-- 第 5 排 (44dp, 刪除鍵加寬至 1.5, 送出鍵 1.5 鎖定右側) -->
        <com.p3dro.scorpio.ime.ui.KeyRowLayout
            android:id="@+id/row_5"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="10.4">

            <!-- 1. ?123 -->
            <FrameLayout
                android:id="@+id/btn_symbols_toggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyFunctionDrawable"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/key_symbols_label"
                    android:textColor="@color/ime_text_primary"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- 2. 逗號 ， -->
            <FrameLayout
                android:id="@+id/btn_comma"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyDrawable"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="，"
                    android:textColor="@color/ime_text_primary"
                    android:textSize="18sp" />
                <!-- 長按輸入句號 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="5dp"
                    android:text="。"
                    android:textColor="@color/ime_text_secondary"
                    android:textSize="10sp" />
            </FrameLayout>

            <!-- 3. 語言切換球 🌐 -->
            <FrameLayout
                android:id="@+id/btn_globe"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyFunctionDrawable"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ime_globe"
                    android:tint="@color/ime_text_primary" />
            </FrameLayout>

            <!-- 4. 空白鍵 (注音) -->
            <FrameLayout
                android:id="@+id/btn_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3.3"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyDrawable"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/tv_space_label"
                    android:text="@string/space_zhuyin"
                    android:textColor="@color/ime_text_secondary"
                    android:textSize="13sp" />
            </FrameLayout>

            <!-- 5. ㄦ 鍵 -->
            <FrameLayout
                android:id="@+id/btn_er"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyDrawable"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="ㄦ"
                    android:textColor="@color/ime_text_primary"
                    android:textSize="18sp" />
            </FrameLayout>

            <!-- 6. 退格刪除鍵 ⌫ (加寬至 1.5，觸控更精準) -->
            <FrameLayout
                android:id="@+id/btn_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyFunctionDrawable"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ime_backspace"
                    android:tint="@color/ime_text_primary" />
            </FrameLayout>

            <!-- 7. Enter 送出鍵 ↵ (權重 1.5，右側絕對對齊) -->
            <FrameLayout
                android:id="@+id/btn_enter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyActionDrawable"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ime_enter" />
            </FrameLayout>
        </com.p3dro.scorpio.ime.ui.KeyRowLayout>
    </LinearLayout>

    <!-- 4. 英文 QWERTY 鍵盤 (高度維持 44dp 與注音完全 1:1，底排送出鍵絕對對齊) -->
    <com.p3dro.scorpio.ime.ui.SpatialKeyLayout
        android:id="@+id/panel_english"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <!-- 數字列與字鍵排：鍵由版面宣告（KeyboardLayout）決定，預設 QWERTY；按鍵高度 44dp 與其它排一致 -->
        <com.p3dro.scorpio.ime.ui.KeyRowLayout
            android:id="@+id/en_row_0"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:weightSum="10" />

        <com.p3dro.scorpio.ime.ui.KeyRowLayout
            android:id="@+id/en_row_1"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="10" />

        <com.p3dro.scorpio.ime.ui.KeyRowLayout
            android:id="@+id/en_row_2"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="10" />

        <!-- Shift、刪除鍵放在宣告的位置（預設第 3 排頭尾） -->
        <com.p3dro.scorpio.ime.ui.KeyRowLayout
            android:id="@+id/en_row_3"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:id="@+id/btn_en_shift"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="14"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyFunctionDrawable"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/iv_en_shift"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ime_shift"
                    android:tint="@color/ime_text_primary" />
                <TextView
                    android:id="@+id/tv_en_shift_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="'"
                    android:textSize="22sp"
                    android:textColor="@color/ime_text_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_en_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="16"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyFunctionDrawable"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ime_backspace"
                    android:tint="@color/ime_text_primary" />
            </FrameLayout>
        </com.p3dro.scorpio.ime.ui.KeyRowLayout>

        <!-- 第 4 排（字鍵最多 4 排，宣告了第 4 排字鍵的版面才顯示） -->
        <com.p3dro.scorpio.ime.ui.KeyRowLayout
            android:id="@+id/en_row_extra"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- 第 4 排：底排 (?123, 逗號, 🌐, Space, 句號, Enter)
             權重總和 10.4，送出鍵位於 8.9~10.4 與注音排完全重合，絕不位移 -->
        <com.p3dro.scorpio.ime.ui.KeyRowLayout
            android:id="@+id/en_row_4"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="10.4">

            <FrameLayout
                android:id="@+id/btn_en_symbols"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyFunctionDrawable"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/key_symbols_label"
                    android:textColor="@color/ime_text_primary"
                    android:textSize="14sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_en_comma"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyDrawable"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text=","
                    android:textColor="@color/ime_text_primary"
                    android:textSize="18sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_en_globe"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyFunctionDrawable"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ime_globe"
                    android:tint="@color/ime_text_primary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_en_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4.7"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyDrawable"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:id="@+id/tv_en_space_label"
                    android:text="English"
                    android:textColor="@color/ime_text_secondary"
                    android:textSize="13sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_en_period"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.0"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyDrawable"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="."
                    android:textColor="@color/ime_text_primary"
                    android:textSize="18sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_en_enter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:layout_marginStart="2.5dp"
                android:layout_marginEnd="2.5dp"
                android:background="?attr/imeKeyActionDrawable"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ime_enter" />
            </FrameLayout>
        </com.p3dro.scorpio.ime.ui.KeyRowLayout>
    </com.p3dro.scorpio.ime.ui.SpatialKeyLayout>

    <!-- 5. 數字與常用標點鍵盤 (44dp，空間座標定位) -->
    <com.p3dro.scorpio.ime.ui.SpatialKeyLayout
        android:id="@+id/panel_symbols"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp" />

    <!-- 數字／電話／日期時間鍵盤（輸入框要的是數字時自動出現；內容由程式建立，高度同注音／英文鍵盤） -->
    <com.p3dro.scorpio.ime.ui.SpatialKeyLayout
        android:id="@+id/panel_numpad"
