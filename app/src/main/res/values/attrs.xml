<?xml version="1.0" encoding="utf-8"?>
<!-- 鍵盤主題色（各主題 style 提供，res/color/ime_* 以 ?attr 參照） -->
<resources>
    <attr name="imeBg" format="color|reference" />
    <attr name="imeKeyBg" format="color|reference" />
    <attr name="imeKeyFunctionBg" format="color|reference" />
    <attr name="imeKeyPressed" format="color|reference" />
    <attr name="imeKeyActionBg" format="color|reference" />
    <attr name="imeKeyActionIcon" format="color|reference" />
    <attr name="imeTextPrimary" format="color|reference" />
    <attr name="imeTextSecondary" format="color|reference" />
    <attr name="imeCandidateBg" format="color|reference" />
    <attr name="imeCandidateText" format="color|reference" />
    <attr name="imeCandidateDivider" format="color|reference" />
    <attr name="imeComposingText" format="color|reference" />
    <!-- 外觀選項（ImeOverlay.* 覆蓋）：按鍵邊框粗細與顏色、鍵盤上方圓角 -->
    <attr name="imeKeyStroke" format="dimension" />
    <attr name="imeKeyStrokeColor" format="color|reference" />
    <attr name="imeKeyboardRadius" format="dimension" />
    <!-- 按鍵底圖：預設按下瞬間變色，ImeOverlay.Ripple 換成漣漪版 -->
    <attr name="imeKeyDrawable" format="reference" />
    <attr name="imeKeyFunctionDrawable" format="reference" />
    <attr name="imeKeyActionDrawable" format="reference" />
</resources>
