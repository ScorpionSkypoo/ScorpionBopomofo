<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ScorpioIME" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ime_classic_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ime_classic_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">?attr/isLightTheme</item>
        <item name="imeBg">@color/ime_classic_bg</item>
        <item name="imeKeyBg">@color/ime_classic_key_bg</item>
        <item name="imeKeyFunctionBg">@color/ime_classic_key_function_bg</item>
        <item name="imeKeyPressed">@color/ime_classic_key_pressed</item>
        <item name="imeKeyActionBg">@color/ime_classic_key_action_bg</item>
        <item name="imeKeyActionIcon">@color/ime_classic_key_action_icon</item>
        <item name="imeTextPrimary">@color/ime_classic_text_primary</item>
        <item name="imeTextSecondary">@color/ime_classic_text_secondary</item>
        <item name="imeCandidateBg">@color/ime_classic_candidate_bg</item>
        <item name="imeCandidateText">@color/ime_classic_candidate_text</item>
        <item name="imeCandidateDivider">@color/ime_classic_candidate_divider</item>
        <item name="imeComposingText">@color/ime_classic_composing_text</item>
    </style>

    <!-- 設定 App：Material 3，Android 12 以上跟著桌布取色 -->
    <style name="Theme.ScorpioIME.Settings" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">?attr/isLightTheme</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <!-- 鍵盤主題：經典（跟著系統淺色／深色） -->
    <style name="ImeTheme.Classic" parent="Theme.ScorpioIME">
        <item name="imeBg">@color/ime_classic_bg</item>
        <item name="imeKeyBg">@color/ime_classic_key_bg</item>
        <item name="imeKeyFunctionBg">@color/ime_classic_key_function_bg</item>
        <item name="imeKeyPressed">@color/ime_classic_key_pressed</item>
        <item name="imeKeyActionBg">@color/ime_classic_key_action_bg</item>
        <item name="imeKeyActionIcon">@color/ime_classic_key_action_icon</item>
        <item name="imeTextPrimary">@color/ime_classic_text_primary</item>
        <item name="imeTextSecondary">@color/ime_classic_text_secondary</item>
        <item name="imeCandidateBg">@color/ime_classic_candidate_bg</item>
        <item name="imeCandidateText">@color/ime_classic_candidate_text</item>
        <item name="imeCandidateDivider">@color/ime_classic_candidate_divider</item>
        <item name="imeComposingText">@color/ime_classic_composing_text</item>
    </style>

    <!-- 鍵盤主題：動態取色（Android 12 以上跟著桌布配色） -->
    <style name="ImeTheme.Dynamic" parent="Theme.ScorpioIME">
        <item name="imeBg">@color/ime_dyn_bg</item>
        <item name="imeKeyBg">@color/ime_dyn_key_bg</item>
        <item name="imeKeyFunctionBg">@color/ime_dyn_key_function_bg</item>
        <item name="imeKeyPressed">@color/ime_dyn_key_pressed</item>
        <item name="imeKeyActionBg">@color/ime_dyn_key_action_bg</item>
        <item name="imeKeyActionIcon">@color/ime_dyn_key_action_icon</item>
        <item name="imeTextPrimary">@color/ime_dyn_text_primary</item>
        <item name="imeTextSecondary">@color/ime_dyn_text_secondary</item>
        <item name="imeCandidateBg">@color/ime_dyn_candidate_bg</item>
        <item name="imeCandidateText">@color/ime_dyn_candidate_text</item>
        <item name="imeCandidateDivider">@color/ime_dyn_candidate_divider</item>
        <item name="imeComposingText">@color/ime_dyn_composing_text</item>
    </style>

    <!-- 鍵盤主題：照片背景（半透明按鍵、白字） -->
    <style name="ImeTheme.Photo" parent="Theme.ScorpioIME">
        <item name="imeBg">#00000000</item>
        <item name="imeKeyBg">#40FFFFFF</item>
        <item name="imeKeyFunctionBg">#26FFFFFF</item>
        <item name="imeKeyPressed">#66FFFFFF</item>
        <item name="imeKeyActionBg">#E61A73E8</item>
        <item name="imeKeyActionIcon">#FFFFFFFF</item>
        <item name="imeTextPrimary">#FFFFFFFF</item>
        <item name="imeTextSecondary">#D9FFFFFF</item>
        <item name="imeCandidateBg">#00000000</item>
        <item name="imeCandidateText">#FFFFFFFF</item>
        <item name="imeCandidateDivider">#00000000</item>
        <item name="imeComposingText">#FFA8C7FA</item>
    </style>
</resources>
